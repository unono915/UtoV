{
  "name": "utov",
  "productName": "UtoV",
  "version": "1.0.3",
  "description": "유튜브 영상을 구간 지정하여 내려받는 데스크톱 도구",
  "author": {
    "name": "UtoV"
  },
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "preview": "node scripts/preview.mjs",
    "setup": "node scripts/fetch-binaries.mjs",
    "dist": "electron-builder --win portable nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "kr.utov.app",
    "productName": "UtoV",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "UtoV-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "UtoV",
      "artifactName": "UtoV-setup.exe"
    },
    "compression": "maximum"
  }
}
